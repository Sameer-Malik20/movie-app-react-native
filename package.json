    "expo": "~53.0.22",
    "expo-asset": "~11.1.7",
    "expo-av": "~15.1.7",
    "expo-font": "~13.3.2",
    "expo-screen-orientation": "~8.1.7",
    "react": "19.0.0",
    "react-native": "0.79.6",
    "react-native-safe-area-context": "5.4.0"
  },
  "devDependencies": {
    "@expo/ngrok": "^4.1.3",
    "babel-preset-expo": "~13.0.0"
  },
